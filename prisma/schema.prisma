generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  fullName      String   @default("")
  phone         String   @default("")
  role          String   @default("free")  // "free" or "pro"
  proExpiresAt  DateTime?
  isActive      Boolean  @default(true)
  lastLogin     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  aiUsageLogs   AiUsageLog[]
  paymentProofs PaymentProof[]
}

model AiUsageLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  message   String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model PaymentProof {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  fileName    String   @default("")
  filePath    String   @default("")
  fileSize    Int      @default(0)
  status      String   @default("pending")  // "pending", "approved", "rejected"
  userNote    String   @default("")
  adminNote   String   @default("")
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Country {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  flagEmoji     String
  flagUrl       String   @default("")
  continent     String
  currency      String
  currencyCode  String
  timezone      String
  visaFree      Boolean  @default(false)
  visaOnArrival Boolean  @default(false)
  etaAvailable Boolean  @default(false)
  safetyRating  Int      @default(5)
  safetySummary String  @default("")
  bestTravelMonths String @default("")
  avgTempC      String   @default("25")
  monthlyTemps  String   @default("{}")
  processingDaysMin Int   @default(5)
  processingDaysMax Int   @default(30)
  sourceUrl     String   @default("")
  fetchTimestamp DateTime @default(now())
  fetchHash     String   @default("")
  parserVersion String   @default("1.0.0")
  parserConfidence Float @default(0.8)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  visaTypes     VisaType[]
  costProfiles  CostProfile[]
  requirements  VisaRequirement[]
}

model VisaType {
  id          String   @id @default(cuid())
  countryId   String
  country     Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  type        String
  description String   @default("")
  maxDuration String   @default("")
  extensions  Boolean  @default(false)
  multipleEntry Boolean @default(false)
  sourceUrl   String   @default("")
  fetchTimestamp DateTime @default(now())
  parserConfidence Float @default(0.8)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requirements VisaRequirement[]
}

model VisaRequirement {
  id                  String   @id @default(cuid())
  countryId           String
  country             Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@index([countryId])
  visaTypeId          String?
  visaType            VisaType? @relation(fields: [visaTypeId], references: [id], onDelete: Cascade)
  category            String
  requirement         String
  mandatory           Boolean  @default(true)
  description         String   @default("")
  scoringWeight       Float    @default(0.0)
  sourceUrl           String   @default("")
  fetchTimestamp      DateTime @default(now())
  fetchHash           String   @default("")
  parserVersion       String   @default("1.0.0")
  parserConfidence    Float    @default(0.8)
  needsReview         Boolean  @default(false)
  reviewNote          String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model CostProfile {
  id               String   @id @default(cuid())
  countryId        String
  country          Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  visaFeeUSD       Float    @default(0)
  serviceFeeUSD    Float    @default(0)
  processingDays   Int      @default(10)
  monthlyLivingUSD Float    @default(1000)
  monthlyRentUSD   Float    @default(500)
  monthlyFoodUSD   Float    @default(300)
  monthlyTransportUSD Float  @default(100)
  healthInsuranceUSD Float  @default(50)
  totalMonthlyUSD  Float    @default(1000)
  currency         String   @default("")
  sourceUrl        String   @default("")
  fetchTimestamp   DateTime @default(now())
  parserConfidence Float    @default(0.8)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model UserProfile {
  id          String   @id @default(cuid())
  fullName    String   @default("")
  age         Int      @default(25)
  gender      String   @default("")
  nationality String   @default("Pakistani")
  passportNumber String @default("")
  passportExpiry DateTime @default(now())
  occupation   String   @default("")
  monthlyIncomeUSD Float @default(0)
  savingsUSD   Float    @default(0)
  education    String   @default("")
  languages    String   @default("[]")
  hasCriminalRecord Boolean @default(false)
  hasPriorTravel Boolean @default(false)
  priorCountries String @default("[]")
  hasHealthInsurance Boolean @default(false)
  hasSponsor Boolean @default(false)
  sponsorRelation String @default("")
  sponsorIncomeUSD Float @default(0)
  travelPurpose String @default("")
  intendedStayDays Int @default(30)
  hasReturnTicket Boolean @default(false)
  hasHotelBooking Boolean @default(false)
  budgetUSD    Float    @default(0)
  maritalStatus String @default("")
  dependents   Int      @default(0)
  hasSpecialNeeds Boolean @default(false)
  additionalNotes String @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions    Session[]
}

model Session {
  id              String   @id @default(cuid())
  userProfileId   String
  userProfile     UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId])
  status          String   @default("in_progress")
  questionnaireProgress Float @default(0)
  currentStep     Int      @default(0)
  answers         String   @default("{}")
  scores          String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  auditLogs       AuditLog[]
}

model AuditLog {
  id              String   @id @default(cuid())
  sessionId       String
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  action          String
  countryId       String?
  component       String
  score           Float?
  weight          Float?
  multiplier      Float?
  confidence      Float?
  sourceUrl       String?
  details         String   @default("")
  createdAt       DateTime @default(now())
}

model ScoringWeight {
  id          String   @id @default(cuid())
  category    String   @unique
  weight      Float    @default(0.0)
  editable    Boolean  @default(true)
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminUser {
  id            String    @id @default(cuid())
  username      String    @unique
  passwordHash  String
  role          String    @default("admin")
  permissions   String    @default("full")
  isOnline      Boolean   @default(false)
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model SiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
  isActive     Boolean  @default(true)
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  event     String
  data      String   @default("{}")
  ip        String   @default("unknown")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([event])
}

model AdminNotification {
  id        String   @id @default(cuid())
  type      String   @default("info")  // "payment_proof", "user_signup", "info"
  title     String
  message   String
  isRead    Boolean  @default(false)
  data      String   @default("{}")  // JSON for extra data
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String   @default("")
  message   String
  isRead    Boolean  @default(false)
  isReplied Boolean  @default(false)
  reply     String   @default("")
  repliedAt DateTime?
  ip        String   @default("unknown")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead])
  @@index([createdAt])
}

model VisitorSession {
  id        String   @id @default(cuid())
  sessionId String
  ip        String   @default("unknown")
  country   String   @default("")
  city      String   @default("")
  page      String   @default("")
  referrer      String   @default("")
  referrerCategory String @default("direct") // "direct","organic","social","referral"
  userAgent     String   @default("")
  device        String   @default("")  // "Desktop","Mobile","Tablet"
  browser       String   @default("")  // "Chrome","Safari",etc.
  os            String   @default("")  // "Windows","Android",etc.
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([lastSeen])
  @@index([createdAt])
  @@index([country])
  @@index([referrerCategory])
  @@index([device])
}

model SearchLog {
  id        String   @id @default(cuid())
  query     String
  ip        String   @default("unknown")
  results   Int      @default(0)
  createdAt DateTime @default(now())

  @@index([query])
  @@index([createdAt])
}

model SecurityLog {
  id        String   @id @default(cuid())
  action    String   // "admin_login","admin_login_fail","user_signup","user_login","user_login_fail"
  email     String   @default("")
  ip        String   @default("unknown")
  userAgent String   @default("")
  success   Boolean  @default(true)
  details   String   @default("")
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([success])
}

model AffiliateClick {
  id        String   @id @default(cuid())
  partner   String   // "ivisa","booking","skyscanner","safetywing"
   country   String   @default("")
  ip        String   @default("unknown")
  sessionId String   @default("")
  page      String   @default("")
  createdAt DateTime @default(now())

  @@index([partner])
  @@index([createdAt])
  @@index([country])
}

model Referral {
  id            String   @id @default(cuid())
  refCode       String   @unique              // e.g. "SARA4827"
  referrerIp    String                        // IP of person who created the referral
  referrerSid   String   @default("")        // Browser session ID
  visitorCount  Int      @default(0)          // Unique IPs that visited via this code
  rewardTier    Int      @default(0)          // 0=none, 1=1 query, 3=5 queries, 5=1 day pro
  bonusQueries  Int      @default(0)          // Extra queries earned
  proDaysEarned Int      @default(0)          // Free Pro days earned
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  visitors      ReferralVisitor[]

  @@index([referrerIp])
  @@index([refCode])
  @@index([createdAt])
}

model ReferralVisitor {
  id         String   @id @default(cuid())
  referralId String
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  @@index([referralId])
  visitorIp  String
  visitedAt  DateTime @default(now())

  @@index([visitorIp])
  @@index([visitedAt])
}